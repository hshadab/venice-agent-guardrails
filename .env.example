# Venice — get one at https://venice.ai/settings/api
VENICE_API_KEY=

# ICME — sign up at https://docs.icme.io
ICME_API_KEY=

# Created by `npm run setup-policy`. Paste the printed policy_id here.
ICME_POLICY_ID=

# Optional overrides
VENICE_BASE_URL=https://api.venice.ai/api/v1
ICME_BASE_URL=https://api.icme.io/v1
VENICE_E2EE_MODEL=e2ee-venice-uncensored-24b-p
