{
  "name": "venice-agent-guardrails",
  "version": "0.1.0",
  "description": "Private, verifiable guardrails for Venice E2EE agents. Wraps Venice chat completions with ICME Preflight policy checks and returns a SNARK proof per action.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./venice": "./src/venice.js",
    "./preflight": "./src/preflight.js"
  },
  "bin": {
    "venice-guardrails-mcp": "mcp/server.js"
  },
  "files": [
    "src",
    "mcp",
    "examples",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "example": "node examples/basic.js",
    "mcp": "node mcp/server.js",
    "setup-policy": "node scripts/setup-policy.js",
    "test": "node --test",
    "lint": "eslint ."
  },
  "keywords": [
    "venice",
    "venice-ai",
    "icme",
    "preflight",
    "privacy",
    "tee",
    "agent",
    "mcp",
    "library"
  ],
  "license": "MIT",
  "author": "hshadab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hshadab/venice-agent-guardrails.git"
  },
  "bugs": {
    "url": "https://github.com/hshadab/venice-agent-guardrails/issues"
  },
  "homepage": "https://github.com/hshadab/venice-agent-guardrails#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  }
}
